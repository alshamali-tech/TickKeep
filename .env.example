# TimeVault — build-time configuration (all optional)
# Copy to .env and fill in for your deployment.

# Public URL of the deployed site (used only in docs/sitemap examples today)
VITE_APP_URL=https://timevault.app

# Donation links — shown in the footer, sidebar and Settings → About.
# These are plain external links; no provider JS is ever loaded.
VITE_KOFI_URL=https://ko-fi.com/yourhandle
VITE_BMC_URL=https://buymeacoffee.com/yourhandle
VITE_PAYPAL_URL=https://paypal.me/yourhandle
